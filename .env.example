# ---------------------------------------------------------------------------
# Configuration template. Copy to .env and fill in your own values.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.
#
# NOTE: none of these are needed to run the analysis pipeline. The pipeline
# reads only the CSV extracts in data_private/. These variables are for
# regenerating those extracts from BigQuery and for the reference-checking
# helpers.
# ---------------------------------------------------------------------------

# --- Google BigQuery, to regenerate data_private/ from eICU-CRD -------------
# Your own billing project. The eICU tables themselves live in the public
# physionet-data project and are not owned by you. Access requires PhysioNet
# credentialing and a signed data use agreement; see DATA_SOURCE.md.
GCP_PROJECT_ID=your-billing-project-id
EICU_DATASET=physionet-data.eicu_crd

# --- NCBI E-utilities, for verifying references against PubMed -------------
# Optional. Without a key you are rate-limited to 3 requests/second.
# Obtain one at https://account.ncbi.nlm.nih.gov/settings/
PUBMED_API_KEY=

# --- Crossref polite pool, for reference retrieval -------------------------
# Not a secret. Crossref asks for a contact address so it can reach you rather
# than silently throttling; supply your own.
CROSSREF_MAILTO=you@example.edu
